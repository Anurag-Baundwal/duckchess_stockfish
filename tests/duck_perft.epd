# Duck perft positions. Counts come from wakwak's splitperft, see
# gen_duck_perft.py, and are checked by duck_perft_check.py. A terminal
# position below the root (no king or no chess move for the side to move,
# or a halfmove clock of 100) counts as one node.

# Start position, and black's reply after 1.e4 with the duck on e5
rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1 ;D1 640 ;D2 379440 ;D3 249921262 ;D4 164318412891
rnbqkbnr/pppppppp/8/4*3/4P3/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1 ;D1 589 ;D2 518554 ;D3 335822826

# No duck yet: the first duck may go on any empty square
r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3 ;D1 865 ;D2 787127 ;D3 677848995
r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1 ;D1 1544 ;D2 1980939 ;D3 2888667469

# Castling: duck off both paths, on f1 (blocks O-O), on b1 (blocks O-O-O
# through the rook's path), and on d8 for black
r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1 ;D1 1510 ;D2 1940435 ;D3 2752668031
r3k2r/8/8/8/8/8/8/R3K*1R w KQkq - 0 1 ;D1 1313 ;D2 1664391 ;D3 2400836710
r3k2r/8/8/8/8/8/8/R*2K2R w KQkq - 0 1 ;D1 1256 ;D2 1584192 ;D3 2295586454
r2*k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1 ;D1 1313 ;D2 1664391 ;D3 2408813400

# Castling out of and through attacked squares is allowed
r3k2r/8/8/8/8/8/3q4/R3K2R w KQkq - 0 1 ;D1 1485 ;D2 3625405 ;D3 4922461401

# En passant, and the duck on the en passant square forbidding it
rnbqkbnr/ppp1pppp/8/3pP3/8/7*/PPPP1PPP/RNBQKBNR w KQkq d6 0 3 ;D1 869 ;D2 687499 ;D3 635103770
rnbqkbnr/ppp1pppp/3*4/3pP3/8/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 3 ;D1 930 ;D2 733135 ;D3 672508137

# A double push next to an enemy pawn allows en passant, unless the same
# move puts the duck on the skipped square
4k3/8/8/8/1p6/8/P7/4K3 w - - 0 1 ;D1 420 ;D2 153342 ;D3 71950392 ;D4 32350758680

# Promotions with and without capture, for both sides
1r2k3/P7/8/8/8/8/7p/4K1N1 w - - 0 1 ;D1 932 ;D2 1024088 ;D3 897119816

# King captures: available to the side to move, then against it, and
# between adjacent kings
4k3/8/8/8/8/8/8/4K2r b - - 0 1 ;D1 916 ;D2 252183 ;D3 261696689
4k3/8/8/8/8/8/8/4K2r w - - 0 1 ;D1 305 ;D2 302938 ;D3 122342518
8/8/8/3kK3/8/8/8/8 w - - 0 1 ;D1 497 ;D2 208931 ;D3 93055506

# No chess move: the side to move wins. At the root, and below it when black
# puts the duck on b3
7k/8/8/8/p1p5/P*P5/PPP5/KB6 w - - 0 1 ;D1 0 ;D2 0 ;D3 0
7k/8/8/8/p1p5/P1P5/PPP5/KB5* b - - 0 1 ;D1 159 ;D2 16380 ;D3 6863727

# Halfmove clock 99: every quiet move ends the game; a pawn move does not
4k3/8/8/8/8/8/8/R3K3 w Q - 99 80 ;D1 976 ;D2 976 ;D3 976
4k3/8/8/8/8/8/4P3/R3K3 w Q - 99 80 ;D1 1020 ;D2 35710 ;D3 33443870

# The duck blocks a queen, a double push, and a single push
4k3/8/8/8/3*4/8/3Q4/4K3 w - - 0 1 ;D1 1260 ;D2 371700 ;D3 572625648
4k3/8/8/8/4*3/8/4P3/4K3 w - - 0 1 ;D1 300 ;D2 88500 ;D3 37534500
4k3/8/8/8/8/4*3/4P3/4K3 w - - 0 1 ;D1 240 ;D2 70800 ;D3 31265400

# Duck960 castling: king b1 between the rooks; the duck on f1 blocks only
# O-O; with the king on f1, the duck on b1 blocks only O-O-O; O-O with the
# king already on g1; O-O-O with the rook already on d1
1r4kr/8/8/8/8/8/8/RK5R w HAhb - 0 1 ;D1 1451 ;D2 1877008 ;D3 2561898760
